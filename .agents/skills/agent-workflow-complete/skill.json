{
  "schemaVersion": 1,
  "name": "agent-workflow-complete",
  "workflowVersion": "1.0.0",
  "mode": "state_write",
  "requiresActiveTask": "optional",
  "allowedWrites": [
    ".workflow/active/<task-id>/**",
    ".workflow/history/<features|fixes|rollbacks>/<task-id>/**",
    ".workflow/history/index.json",
    ".workflow/build-plan.md#<claimed-item>",
    ".workflow/project-overview.md#WORKFLOW:STATUS",
    ".workflow/workflow.json#overview"
  ],
  "commandClasses": ["read_repository", "read_git_state", "workflow_validate", "workflow_state_edit"],
  "stopConditions": ["archive_commit_authorization_required", "multiple_candidates", "no_eligible_task", "open_or_fixed_findings", "proof_incomplete", "recovery_candidate_prepared", "recovery_requires_trusted_change_ci"]
}
