{
  "schemaVersion": 1,
  "name": "agent-workflow-review",
  "workflowVersion": "1.0.0",
  "mode": "state_write",
  "requiresActiveTask": "required",
  "allowedWrites": [".workflow/active/<task-id>/REVIEW.md", ".workflow/active/<task-id>/findings.json", ".workflow/active/<task-id>/task.json"],
  "commandClasses": ["read_repository", "read_git_state", "workflow_validate", "focused_verify", "workflow_state_edit"],
  "stopConditions": ["changes_requested", "findings_digest_mismatch", "no_active_task", "not_independent", "revision_mismatch", "spec_digest_mismatch"]
}
