{
  "schemaVersion": 1,
  "name": "agent-workflow-start",
  "workflowVersion": "1.0.0",
  "mode": "state_write",
  "requiresActiveTask": "absent_or_explicit_supersession",
  "allowedWrites": [
    ".workflow/active/<new-task>/**",
    ".workflow/active/<superseded-task>/**",
    ".workflow/history/<features|fixes|rollbacks>/<superseded-task>/**",
    ".workflow/history/index.json",
    ".workflow/project-overview.md#WORKFLOW:STATUS",
    ".workflow/workflow.json#overview"
  ],
  "commandClasses": ["read_repository", "read_git_state", "workflow_validate", "workflow_state_edit"],
  "stopConditions": ["active_task_exists", "branch_or_worktree_mismatch", "external_authority_required", "visible_claim_collision"]
}
