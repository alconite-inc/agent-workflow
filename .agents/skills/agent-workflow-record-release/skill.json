{
  "schemaVersion": 1,
  "name": "agent-workflow-record-release",
  "workflowVersion": "1.0.0",
  "mode": "release_record_write",
  "requiresActiveTask": "not_used",
  "allowedWrites": [".workflow/releases/<release-id>.json", ".workflow/releases/index.json", ".workflow/operations/<operation-id>.json", ".workflow/operations/index.json"],
  "commandClasses": ["read_repository", "read_git_state", "workflow_validate", "release_evidence_edit"],
  "stopConditions": ["external_operation_not_authorized", "immutable_state_conflict", "record_exists", "revision_mismatch"]
}
