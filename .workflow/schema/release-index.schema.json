{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:release-index:v1",
  "title": "Agent Workflow release index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["releaseId", "path", "recordedOn", "revision", "byteCount", "recordSha256"],
        "properties": {
          "releaseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
          "path": { "type": "string", "pattern": "^releases/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$", "maxLength": 240 },
          "recordedOn": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "byteCount": { "type": "integer", "minimum": 1, "maximum": 2097152 },
          "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
