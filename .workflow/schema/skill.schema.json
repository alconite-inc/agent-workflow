{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:skill:v1",
  "title": "Agent Workflow skill contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "workflowVersion", "mode", "requiresActiveTask", "allowedWrites", "commandClasses", "stopConditions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^agent-workflow-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "workflowVersion": { "const": "1.0.0" },
    "mode": { "enum": ["read_only", "state_write", "code_write", "release_record_write"] },
    "requiresActiveTask": { "enum": ["required", "optional", "absent_or_explicit_supersession", "not_used"] },
    "allowedWrites": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
    "commandClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["read_repository", "read_git_state", "workflow_validate", "workflow_state_edit", "scoped_code_edit", "focused_verify", "full_verify", "release_evidence_edit"] }
    },
    "stopConditions": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 80 } }
  }
}
