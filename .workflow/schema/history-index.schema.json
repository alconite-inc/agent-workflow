{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:history-index:v1",
  "title": "Agent Workflow history index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "kind", "outcome", "closedOn", "buildPlanItemId", "supersedes", "supersededBy", "path", "fileCount", "byteCount", "bundleSha256"],
        "properties": {
          "taskId": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["feature", "fix", "rollback"] },
          "outcome": { "enum": ["completed", "cancelled", "superseded"] },
          "closedOn": { "$ref": "#/$defs/date" },
          "buildPlanItemId": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{2,8}-BP-[0-9]{3,6}$" }, { "type": "null" }] },
          "supersedes": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "supersededBy": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "path": { "type": "string", "pattern": "^history/(features|fixes|rollbacks)/[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 240 },
          "fileCount": { "type": "integer", "minimum": 2, "maximum": 16 },
          "byteCount": { "type": "integer", "minimum": 1, "maximum": 33554432 },
          "bundleSha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
