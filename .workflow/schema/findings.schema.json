{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:findings:v1",
  "title": "Agent Workflow findings ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/id" },
    "findings": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actorKind", "actorRole", "actorRef"],
      "properties": { "actorKind": { "enum": ["human", "agent", "system"] }, "actorRole": { "enum": ["requester", "archaeologist", "architect", "developer", "reviewer", "deployer", "validator"] }, "actorRef": { "type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$" } },
      "allOf": [{ "if": { "properties": { "actorRole": { "const": "requester" } }, "required": ["actorRole"] }, "then": { "properties": { "actorKind": { "const": "human" } } } }]
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "line", "note"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$" }, "line": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 10000000 }, { "type": "null" }] }, "note": { "type": "string", "minLength": 1, "maxLength": 500 } }
    },
    "fixedBy": { "type": "object", "additionalProperties": false, "required": ["actorRef", "date"], "properties": { "actorRef": { "type": "string", "minLength": 3, "maxLength": 120 }, "date": { "$ref": "#/$defs/date" } } },
    "followUp": { "type": "object", "additionalProperties": false, "required": ["id", "owner", "action"], "properties": { "id": { "type": "string", "minLength": 3, "maxLength": 80 }, "owner": { "type": "string", "minLength": 1, "maxLength": 120 }, "action": { "type": "string", "minLength": 1, "maxLength": 500 } } },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "date", "decisionBy", "recordedBy", "from", "to", "resolution", "reason", "evidence"],
      "properties": { "sequence": { "type": "integer", "minimum": 1, "maximum": 1000 }, "date": { "$ref": "#/$defs/date" }, "decisionBy": { "$ref": "#/$defs/actor" }, "recordedBy": { "$ref": "#/$defs/actor" }, "from": { "anyOf": [{ "enum": ["open", "fixed", "closed"] }, { "type": "null" }] }, "to": { "enum": ["open", "fixed", "closed"] }, "resolution": { "anyOf": [{ "enum": ["resolved", "false_positive", "deferred"] }, { "type": "null" }] }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } } },
      "allOf": [{ "if": { "properties": { "to": { "const": "closed" }, "resolution": { "enum": ["resolved", "false_positive"] } }, "required": ["to", "resolution"] }, "then": { "properties": { "evidence": { "minItems": 1 } } } }]
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "status", "resolution", "fixedBy", "summary", "evidence", "disposition", "followUp", "events"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-F[0-9]{3,6}$", "maxLength": 90 }, "severity": { "enum": ["P0", "P1", "P2", "P3"] }, "status": { "enum": ["open", "fixed", "closed"] }, "resolution": { "anyOf": [{ "enum": ["resolved", "false_positive", "deferred"] }, { "type": "null" }] }, "fixedBy": { "anyOf": [{ "$ref": "#/$defs/fixedBy" }, { "type": "null" }] }, "summary": { "type": "string", "minLength": 1, "maxLength": 300 }, "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } }, "disposition": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }] }, "followUp": { "anyOf": [{ "$ref": "#/$defs/followUp" }, { "type": "null" }] }, "events": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/event" } } },
      "allOf": [
        { "if": { "properties": { "status": { "const": "open" } }, "required": ["status"] }, "then": { "properties": { "resolution": { "type": "null" }, "fixedBy": { "type": "null" }, "disposition": { "type": "null" }, "followUp": { "type": "null" } } } },
        { "if": { "properties": { "status": { "const": "fixed" } }, "required": ["status"] }, "then": { "properties": { "resolution": { "type": "null" }, "fixedBy": { "$ref": "#/$defs/fixedBy" }, "disposition": { "type": "null" }, "followUp": { "type": "null" } } } },
        { "if": { "properties": { "status": { "const": "closed" } }, "required": ["status"] }, "then": { "properties": { "resolution": { "enum": ["resolved", "false_positive", "deferred"] }, "fixedBy": { "type": "null" } } } },
        { "if": { "properties": { "resolution": { "enum": ["resolved", "false_positive"] } }, "required": ["resolution"] }, "then": { "properties": { "status": { "const": "closed" }, "disposition": { "type": "null" }, "followUp": { "type": "null" } } } },
        { "if": { "properties": { "resolution": { "const": "deferred" } }, "required": ["resolution"] }, "then": { "properties": { "status": { "const": "closed" }, "severity": { "enum": ["P2", "P3"] }, "disposition": { "type": "string", "minLength": 1 }, "followUp": { "$ref": "#/$defs/followUp" } } } }
      ]
    }
  }
}
