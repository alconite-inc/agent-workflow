{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:operation-index:v1",
  "title": "Agent Workflow operation index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operationId", "kind", "path", "recordedOn", "byteCount", "recordSha256"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
          "kind": { "enum": ["deployment", "rollback", "emergency_mitigation"] },
          "path": { "type": "string", "pattern": "^operations/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$", "maxLength": 240 },
          "recordedOn": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "byteCount": { "type": "integer", "minimum": 1, "maximum": 2097152 },
          "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
