{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:release:v1",
  "title": "Agent Workflow source release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "kind", "tag", "revision", "recordedOn", "result", "evidence", "taskIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "$ref": "#/$defs/id" },
    "kind": { "const": "source_release" },
    "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "revision": { "$ref": "#/$defs/revision" },
    "recordedOn": { "$ref": "#/$defs/date" },
    "result": { "enum": ["succeeded", "failed", "cancelled"] },
    "evidence": { "$ref": "#/$defs/references" },
    "taskIds": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "references": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$" } }
  }
}
