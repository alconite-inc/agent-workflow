{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:operation:v1",
  "title": "Agent Workflow operation",
  "oneOf": [
    { "$ref": "#/$defs/deployment" },
    { "$ref": "#/$defs/rollback" },
    { "$ref": "#/$defs/emergency" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "result": { "enum": ["succeeded", "failed", "cancelled"] },
    "reference": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$" },
    "taskIds": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operationId", "kind", "releaseId", "revision", "environment", "result", "recordedOn", "evidence", "rollbackReference", "taskIds"],
      "properties": {
        "schemaVersion": { "const": 1 }, "operationId": { "$ref": "#/$defs/id" }, "kind": { "const": "deployment" }, "releaseId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" },
        "environment": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 }, "result": { "$ref": "#/$defs/result" }, "recordedOn": { "$ref": "#/$defs/date" }, "evidence": { "$ref": "#/$defs/reference" }, "rollbackReference": { "$ref": "#/$defs/reference" }, "taskIds": { "$ref": "#/$defs/taskIds" }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operationId", "kind", "fromRevision", "toRevision", "targetReleaseId", "reason", "result", "recordedOn", "recoveryEvidence", "taskIds"],
      "properties": {
        "schemaVersion": { "const": 1 }, "operationId": { "$ref": "#/$defs/id" }, "kind": { "const": "rollback" }, "fromRevision": { "$ref": "#/$defs/revision" }, "toRevision": { "$ref": "#/$defs/revision" }, "targetReleaseId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "result": { "$ref": "#/$defs/result" }, "recordedOn": { "$ref": "#/$defs/date" }, "recoveryEvidence": { "$ref": "#/$defs/reference" }, "taskIds": { "$ref": "#/$defs/taskIds" }
      }
    },
    "emergency": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operationId", "kind", "affectedRevision", "incidentReference", "recoveryReference", "reason", "result", "recordedOn", "followUpTaskId", "taskIds"],
      "properties": {
        "schemaVersion": { "const": 1 }, "operationId": { "$ref": "#/$defs/id" }, "kind": { "const": "emergency_mitigation" }, "affectedRevision": { "$ref": "#/$defs/revision" }, "incidentReference": { "$ref": "#/$defs/reference" }, "recoveryReference": { "$ref": "#/$defs/reference" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 }, "result": { "$ref": "#/$defs/result" }, "recordedOn": { "$ref": "#/$defs/date" }, "followUpTaskId": { "$ref": "#/$defs/id" }, "taskIds": { "$ref": "#/$defs/taskIds" }
      }
    }
  }
}
