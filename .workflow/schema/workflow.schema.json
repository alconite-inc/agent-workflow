{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:workflow:v1",
  "title": "Agent Workflow configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "name", "projectId", "canonicalRoot", "activeTaskLimit", "cutover", "overview", "buildPlan", "derivation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowVersion": { "const": "1.0.0" },
    "name": { "const": "Agent Workflow" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "canonicalRoot": { "const": ".workflow" },
    "activeTaskLimit": { "const": 1 },
    "cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "native" } }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "outputSha256", "refreshedOn", "inputs"],
      "properties": {
        "outputPath": { "const": "project-overview.md" },
        "outputSha256": { "$ref": "#/$defs/hash" },
        "refreshedOn": { "$ref": "#/$defs/date" },
        "inputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "sha256": { "$ref": "#/$defs/hash" }
            }
          }
        }
      }
    },
    "buildPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineCompletedIds"],
      "properties": {
        "baselineCompletedIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/buildId" }
        }
      }
    },
    "derivation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provenancePath", "noticePath", "sourceMapPath"],
          "properties": {
            "mode": { "const": "original" },
            "provenancePath": { "const": "DESIGN_PROVENANCE.md" },
            "noticePath": { "type": "null" },
            "sourceMapPath": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provenancePath", "noticePath", "sourceMapPath"],
          "properties": {
            "mode": { "const": "adapted" },
            "provenancePath": { "const": "DESIGN_PROVENANCE.md" },
            "noticePath": { "const": "THIRD_PARTY_NOTICES.md" },
            "sourceMapPath": { "const": "SOURCE_MAP.md" }
          }
        }
      ]
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$" },
    "buildId": { "type": "string", "pattern": "^[A-Z]{2,8}-BP-[0-9]{3,6}$" }
  }
}
