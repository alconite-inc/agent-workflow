{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow:schema:change-manifest:v1",
  "title": "Trusted Agent Workflow change manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "eventName", "eventBaseRevision", "subjectHeadRevision", "checkoutRevision", "ancestry", "changedPaths", "revisionChanges", "revisionRelations", "recoveryCandidates", "checkpointProjections", "baseState"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "trusted_change" },
    "eventName": { "enum": ["pull_request", "push", "workflow_dispatch"] },
    "eventBaseRevision": { "$ref": "#/$defs/revision" },
    "subjectHeadRevision": { "$ref": "#/$defs/revision" },
    "checkoutRevision": { "$ref": "#/$defs/revision" },
    "ancestry": {
      "type": "object", "additionalProperties": false,
      "required": ["eventBaseExists", "subjectHeadExists", "checkoutExists", "eventBaseAncestorOfSubject", "eventBaseAncestorOfCheckout", "subjectAncestorOfCheckout"],
      "properties": {
        "eventBaseExists": { "const": true }, "subjectHeadExists": { "const": true }, "checkoutExists": { "const": true }, "eventBaseAncestorOfSubject": { "type": "boolean" }, "eventBaseAncestorOfCheckout": { "const": true }, "subjectAncestorOfCheckout": { "const": true }
      }
    },
    "changedPaths": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/change" } },
    "revisionChanges": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["revision", "exists", "ancestorOfSubject", "paths"],
        "properties": { "revision": { "$ref": "#/$defs/revision" }, "exists": { "type": "boolean" }, "ancestorOfSubject": { "type": "boolean" }, "paths": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } } }
      }
    },
    "revisionRelations": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ancestor", "descendant", "isAncestor"],
        "properties": { "ancestor": { "$ref": "#/$defs/revision" }, "descendant": { "$ref": "#/$defs/revision" }, "isAncestor": { "type": "boolean" } }
      }
    },
    "recoveryCandidates": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "taskId", "taskPath", "files", "closureText", "task", "findings", "bundleMetadata", "historyIndexEntry", "historyIndexEntryCount", "historyIndexSha256", "historyIndexCanonicalSha256", "historyIndexRemainderSha256", "buildPlan", "workflowProjection", "overviewSha256", "overviewProjection"],
        "properties": {
          "revision": { "$ref": "#/$defs/revision" },
          "taskId": { "$ref": "#/$defs/id" },
          "taskPath": { "$ref": "#/$defs/path" },
          "files": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "byteCount"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" }, "byteCount": { "type": "integer", "minimum": 1, "maximum": 2097152 } } } },
          "closureText": { "type": "string", "minLength": 1, "maxLength": 1048576 },
          "task": { "type": "object" },
          "findings": { "type": "object" },
          "bundleMetadata": { "type": "object", "additionalProperties": false, "required": ["fileCount", "byteCount", "bundleSha256"], "properties": { "fileCount": { "type": "integer", "minimum": 3, "maximum": 7 }, "byteCount": { "type": "integer", "minimum": 1, "maximum": 14680064 }, "bundleSha256": { "$ref": "#/$defs/hash" } } },
          "historyIndexEntry": { "type": "object" },
          "historyIndexEntryCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "historyIndexSha256": { "$ref": "#/$defs/hash" },
          "historyIndexCanonicalSha256": { "$ref": "#/$defs/hash" },
          "historyIndexRemainderSha256": { "$ref": "#/$defs/hash" },
          "buildPlan": {
            "type": "object", "additionalProperties": false,
            "required": ["sha256", "structureSha256", "items"],
            "properties": {
              "sha256": { "$ref": "#/$defs/hash" }, "structureSha256": { "$ref": "#/$defs/hash" },
              "items": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["id", "checked", "marker"], "properties": { "id": { "type": "string", "pattern": "^[A-Z]{2,8}-BP-[0-9]{3,6}$" }, "checked": { "type": "boolean" }, "marker": { "enum": [" ", "x", "X"] } } } }
            }
          },
          "workflowProjection": {
            "type": "object", "additionalProperties": false,
            "required": ["nonOverviewSha256", "overviewInputs", "overviewOutputSha256", "overviewRefreshedOn"],
            "properties": {
              "nonOverviewSha256": { "$ref": "#/$defs/hash" },
              "overviewInputs": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } } } },
              "overviewOutputSha256": { "$ref": "#/$defs/hash" }, "overviewRefreshedOn": { "type": "string", "format": "date" }
            }
          },
          "overviewSha256": { "$ref": "#/$defs/hash" },
          "overviewProjection": {
            "type": "object", "additionalProperties": false,
            "required": ["prefixSha256", "statusSha256", "suffixSha256"],
            "properties": { "prefixSha256": { "$ref": "#/$defs/hash" }, "statusSha256": { "$ref": "#/$defs/hash" }, "suffixSha256": { "$ref": "#/$defs/hash" } }
          }
        }
      }
    },
    "checkpointProjections": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "taskId", "workflowProjection", "overviewSha256", "overviewProjection"],
        "properties": {
          "revision": { "$ref": "#/$defs/revision" },
          "taskId": { "$ref": "#/$defs/id" },
          "workflowProjection": {
            "type": "object", "additionalProperties": false,
            "required": ["nonOverviewSha256", "overviewInputs", "overviewOutputSha256", "overviewRefreshedOn"],
            "properties": {
              "nonOverviewSha256": { "$ref": "#/$defs/hash" },
              "overviewInputs": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } } } },
              "overviewOutputSha256": { "$ref": "#/$defs/hash" },
              "overviewRefreshedOn": { "type": "string", "format": "date" }
            }
          },
          "overviewSha256": { "$ref": "#/$defs/hash" },
          "overviewProjection": {
            "type": "object", "additionalProperties": false,
            "required": ["prefixSha256", "statusSha256", "suffixSha256"],
            "properties": { "prefixSha256": { "$ref": "#/$defs/hash" }, "statusSha256": { "$ref": "#/$defs/hash" }, "suffixSha256": { "$ref": "#/$defs/hash" } }
          }
        }
      }
    },
    "baseState": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowPresent", "workflowSha256", "workflowProjection", "overviewSha256", "overviewProjection", "historyIndexSha256", "releaseIndexSha256", "operationIndexSha256", "buildPlan", "controlFiles", "indexEntries", "indexRemainders", "taskPrefixes"],
      "properties": {
        "workflowPresent": { "type": "boolean" },
        "workflowSha256": { "$ref": "#/$defs/nullableHash" },
        "workflowProjection": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["nonOverviewSha256", "overviewInputs", "overviewOutputSha256", "overviewRefreshedOn"],
              "properties": {
                "nonOverviewSha256": { "$ref": "#/$defs/hash" },
                "overviewInputs": {
                  "type": "array", "maxItems": 32,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["path", "sha256"],
                    "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } }
                  }
                },
                "overviewOutputSha256": { "$ref": "#/$defs/hash" },
                "overviewRefreshedOn": { "type": "string", "format": "date" }
              }
            }
          ]
        },
        "overviewSha256": { "$ref": "#/$defs/nullableHash" },
        "overviewProjection": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["prefixSha256", "statusSha256", "suffixSha256"],
              "properties": {
                "prefixSha256": { "$ref": "#/$defs/hash" },
                "statusSha256": { "$ref": "#/$defs/hash" },
                "suffixSha256": { "$ref": "#/$defs/hash" }
              }
            }
          ]
        },
        "historyIndexSha256": { "$ref": "#/$defs/nullableHash" },
        "releaseIndexSha256": { "$ref": "#/$defs/nullableHash" },
        "operationIndexSha256": { "$ref": "#/$defs/nullableHash" },
        "buildPlan": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["sha256", "structureSha256", "items"],
              "properties": {
                "sha256": { "$ref": "#/$defs/hash" },
                "structureSha256": { "$ref": "#/$defs/hash" },
                "items": {
                  "type": "array", "maxItems": 10000,
                  "items": { "type": "object", "additionalProperties": false, "required": ["id", "checked", "marker"], "properties": { "id": { "type": "string", "pattern": "^[A-Z]{2,8}-BP-[0-9]{3,6}$" }, "checked": { "type": "boolean" }, "marker": { "enum": [" ", "x", "X"] } } }
                }
              }
            }
          ]
        },
        "controlFiles": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "kind", "exists", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "kind": { "enum": ["history", "release", "operation", "index"] },
              "exists": { "type": "boolean" },
              "sha256": { "$ref": "#/$defs/nullableHash" }
            }
          }
        },
        "indexEntries": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["indexKind", "recordId", "exists", "path", "recordSha256", "recordKind", "recordedOn", "revision", "outcome", "buildPlanItemId", "supersedes", "supersededBy", "fileCount", "byteCount"],
            "properties": {
              "indexKind": { "enum": ["history", "release", "operation"] },
              "recordId": { "$ref": "#/$defs/id" },
              "exists": { "type": "boolean" },
              "path": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
              "recordSha256": { "$ref": "#/$defs/nullableHash" },
              "recordKind": { "anyOf": [{ "enum": ["feature", "fix", "rollback", "deployment", "emergency_mitigation"] }, { "type": "null" }] },
              "recordedOn": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
              "revision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
              "outcome": { "anyOf": [{ "enum": ["completed", "cancelled", "superseded"] }, { "type": "null" }] },
              "buildPlanItemId": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{2,8}-BP-[0-9]{3,6}$" }, { "type": "null" }] },
              "supersedes": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "supersededBy": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
              "fileCount": { "anyOf": [{ "type": "integer", "minimum": 2, "maximum": 16 }, { "type": "null" }] },
              "byteCount": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 33554432 }, { "type": "null" }] }
            }
          }
        },
        "indexRemainders": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["indexKind", "recordId", "sha256"],
            "properties": {
              "indexKind": { "enum": ["history", "release", "operation"] },
              "recordId": { "$ref": "#/$defs/id" },
              "sha256": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "taskPrefixes": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["taskId", "path", "files", "taskIdentitySha256", "taskState", "taskEventCount", "taskEventsSha256", "findingsSha256", "findingPrefixes"],
            "properties": {
              "taskId": { "$ref": "#/$defs/id" },
              "path": { "$ref": "#/$defs/path" },
              "files": { "type": "array", "minItems": 2, "maxItems": 7, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } } } },
              "taskIdentitySha256": { "$ref": "#/$defs/hash" },
              "taskState": {
                "type": "object", "additionalProperties": false,
                "required": ["stage", "specRevision", "specReviewStatus", "specSha256", "checkpointRevision", "checkpointBaseRevision", "verificationStatus", "verificationRevision", "reviewStatus", "reviewRevision", "closureOutcome", "closureFinalRevision", "buildPlanItemId", "specReviewSha256", "checkpointSha256", "verificationSha256", "reviewSha256", "recoverySha256", "closureSha256"],
                "properties": {
                  "stage": { "enum": ["discovery", "specification", "awaiting_spec_review", "approved", "implementation", "verification", "review", "ready_to_archive", "archived"] },
                  "specRevision": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "specReviewStatus": { "enum": ["not_started", "pending", "approved"] },
                  "specSha256": { "$ref": "#/$defs/nullableHash" },
                  "checkpointRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
                  "checkpointBaseRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
                  "verificationStatus": { "enum": ["not_started", "failed", "passed"] },
                  "verificationRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
                  "reviewStatus": { "enum": ["not_started", "changes_requested", "passed"] },
                  "reviewRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
                  "closureOutcome": { "anyOf": [{ "enum": ["completed", "cancelled", "superseded"] }, { "type": "null" }] },
                  "closureFinalRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
                  "buildPlanItemId": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{2,8}-BP-[0-9]{3,6}$" }, { "type": "null" }] },
                  "specReviewSha256": { "$ref": "#/$defs/hash" },
                  "checkpointSha256": { "$ref": "#/$defs/hash" },
                  "verificationSha256": { "$ref": "#/$defs/hash" },
                  "reviewSha256": { "$ref": "#/$defs/hash" },
                  "recoverySha256": { "$ref": "#/$defs/hash" },
                  "closureSha256": { "$ref": "#/$defs/hash" }
                }
              },
              "taskEventCount": { "type": "integer", "minimum": 0, "maximum": 10000 }, "taskEventsSha256": { "$ref": "#/$defs/hash" },
              "findingsSha256": { "$ref": "#/$defs/hash" },
              "findingPrefixes": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": false, "required": ["findingId", "identitySha256", "stateSha256", "eventCount", "eventsSha256"], "properties": { "findingId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-F[0-9]{3,6}$" }, "identitySha256": { "$ref": "#/$defs/hash" }, "stateSha256": { "$ref": "#/$defs/hash" }, "eventCount": { "type": "integer", "minimum": 0, "maximum": 1000 }, "eventsSha256": { "$ref": "#/$defs/hash" } } } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80 },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$" },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["status", "path", "oldPath"],
      "properties": { "status": { "type": "string", "pattern": "^(?:A|M|D|T|(?:R|C)(?:100|0[0-9]{2}))$" }, "path": { "$ref": "#/$defs/path" }, "oldPath": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] } }
    }
  }
}
